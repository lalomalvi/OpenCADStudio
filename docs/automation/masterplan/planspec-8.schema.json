{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencadstudio.local/schemas/planspec-8.json",
  "title": "OpenCADStudio PlanSpec v8 typed door-clearance obstacles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "units",
    "origin",
    "nodes",
    "lines",
    "circles",
    "dimensions",
    "topology",
    "walls",
    "openings",
    "joins",
    "dimension_bindings",
    "dimension_style",
    "dimension_placements",
    "obstacles"
  ],
  "properties": {
    "schema_version": {
      "const": "planspec-8"
    },
    "units": {
      "const": "m"
    },
    "origin": {
      "$ref": "#/$defs/point"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "circles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/circle"
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contours"
      ],
      "properties": {
        "contours": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wall"
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opening"
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/join"
      }
    },
    "dimension_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension_binding"
      }
    },
    "dimension_style": {
      "$ref": "#/$defs/dimension_style"
    },
    "dimension_placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension_placement"
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obstacle"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "number": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/number"
        },
        "y": {
          "$ref": "#/$defs/number"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_px",
        "confidence",
        "classification"
      ],
      "properties": {
        "region_px": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification": {
          "enum": [
            "measured",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "$ref": "#/$defs/number"
        },
        "y": {
          "$ref": "#/$defs/number"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "layer",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/id"
        },
        "end": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "circle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "center",
        "radius",
        "layer",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "center": {
          "$ref": "#/$defs/id"
        },
        "radius": {
          "$ref": "#/$defs/number"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "axis",
        "reference_type",
        "value",
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/id"
        },
        "end": {
          "$ref": "#/$defs/id"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "aligned"
          ]
        },
        "reference_type": {
          "enum": [
            "face",
            "axis",
            "exterior",
            "interior"
          ]
        },
        "value": {
          "$ref": "#/$defs/number"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "line_ids",
        "role",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "line_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "exterior",
            "room"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "thickness_m",
        "layer",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/id"
        },
        "end": {
          "$ref": "#/$defs/id"
        },
        "thickness_m": {
          "$ref": "#/$defs/number"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wall_id",
        "offset_m",
        "width_m",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "wall_id": {
          "$ref": "#/$defs/id"
        },
        "offset_m": {
          "$ref": "#/$defs/number"
        },
        "width_m": {
          "$ref": "#/$defs/number"
        },
        "kind": {
          "enum": [
            "clear",
            "door",
            "window"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "swing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hinge",
            "side",
            "angle_deg",
            "leaf_height_m"
          ],
          "properties": {
            "hinge": {
              "enum": [
                "start",
                "end"
              ]
            },
            "side": {
              "enum": [
                "left",
                "right"
              ]
            },
            "angle_deg": {
              "type": "integer",
              "const": 90
            },
            "leaf_height_m": {
              "$ref": "#/$defs/number"
            }
          }
        },
        "elevation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sill_m",
            "head_m"
          ],
          "properties": {
            "sill_m": {
              "$ref": "#/$defs/number"
            },
            "head_m": {
              "$ref": "#/$defs/number"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "clear"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "swing"
                ]
              },
              {
                "required": [
                  "elevation"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "door"
            }
          },
          "required": [
            "swing"
          ],
          "not": {
            "required": [
              "elevation"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "window"
            }
          },
          "required": [
            "elevation"
          ],
          "not": {
            "required": [
              "swing"
            ]
          }
        }
      ]
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wall_a_id",
        "wall_a_end",
        "wall_b_id",
        "wall_b_end",
        "style",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "wall_a_id": {
          "$ref": "#/$defs/id"
        },
        "wall_a_end": {
          "enum": [
            "start",
            "end"
          ]
        },
        "wall_b_id": {
          "$ref": "#/$defs/id"
        },
        "wall_b_end": {
          "enum": [
            "start",
            "end"
          ]
        },
        "style": {
          "const": "orthogonal_union"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "wall_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_id",
        "side",
        "station_m"
      ],
      "properties": {
        "wall_id": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "enum": [
            "left",
            "right",
            "axis"
          ]
        },
        "station_m": {
          "$ref": "#/$defs/number"
        }
      }
    },
    "dimension_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "start_ref",
        "end_ref",
        "source"
      ],
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/id"
        },
        "start_ref": {
          "$ref": "#/$defs/wall_reference"
        },
        "end_ref": {
          "$ref": "#/$defs/wall_reference"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "dimension_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "text_height_m",
        "arrow_size_m",
        "gap_m",
        "scale",
        "measurement_factor"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "text_height_m": {
          "$ref": "#/$defs/number"
        },
        "arrow_size_m": {
          "$ref": "#/$defs/number"
        },
        "gap_m": {
          "$ref": "#/$defs/number"
        },
        "scale": {
          "const": 1
        },
        "measurement_factor": {
          "const": 1
        }
      }
    },
    "dimension_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "offset_m",
        "layer",
        "source"
      ],
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/id"
        },
        "offset_m": {
          "$ref": "#/$defs/number"
        },
        "layer": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "obstacle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "min_x_m",
        "min_y_m",
        "max_x_m",
        "max_y_m",
        "base_z_m",
        "height_m",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "fixed_partition",
            "furniture",
            "annotation"
          ]
        },
        "min_x_m": {
          "$ref": "#/$defs/number"
        },
        "min_y_m": {
          "$ref": "#/$defs/number"
        },
        "max_x_m": {
          "$ref": "#/$defs/number"
        },
        "max_y_m": {
          "$ref": "#/$defs/number"
        },
        "base_z_m": {
          "$ref": "#/$defs/number"
        },
        "height_m": {
          "$ref": "#/$defs/number"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
